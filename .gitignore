# Secretos / entornos locales (NUNCA subir: credenciales reales de Supabase y Dify)
.env
.env.*
!.env.example
backend/.env
react-export/.env

# Bases de datos locales que no deben versionarse
*.db
*.sqlite
*.sqlite3

# Artefactos de ML: por defecto no se versionan (pueden ser privados/pesados),
# EXCEPTO el modelo oficial del MVP en app/ml/models/, que se necesita en el
# repo para que el deploy (Render) pueda cargarlo sin depender de una ruta
# local fuera del repositorio.
*.pkl
*.joblib
*.joblib.bak*
!backend/app/ml/models/*.pkl

# Python
__pycache__/
backend/**/__pycache__/
*.pyc
backend/venv/
backend/.venv/
backend/.pytest_cache/
backend/tests/.pytest_cache/

# Node / frontend
node_modules/
react-export/node_modules/
dist/
react-export/dist/
react-export/tsconfig.tsbuildinfo

.DS_Store

# Estado local del harness de Claude Code (no forma parte del proyecto)
.claude/
