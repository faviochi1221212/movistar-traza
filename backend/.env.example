ENV=development

# Postgres de Supabase (Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dify Cloud: crea una app "Chatflow/Agent" (clasificador) y otra (asistente),
# copia la API key de cada una en Dify > tu app > API Access
DIFY_API_KEY=
DIFY_CHAT_API_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1

# Microsoft Graph (Outlook). Vacío = integración deshabilitada (modo demo).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=

# Artefactos de ML: el modelo oficial SI esta versionado en el repo
# (app/ml/models/*.pkl, ~2 KB) para que el deploy no dependa de una ruta local.
# Rutas relativas a backend/ (funcionan igual en Windows local y en Render/Linux).
ML_MODEL_PATH=app/ml/models/modelo_riesgo_cliente_traza.pkl
ML_FEATURES_PATH=app/ml/models/features_riesgo_cliente_traza.pkl

# Solo lo usa scripts/seed.py (un script manual, NO el servidor en runtime).
# No hace falta configurarlo en Render: el seed se corre una vez, localmente,
# apuntando via DATABASE_URL a la misma Supabase que usara el servidor.
SEED_DATA_DIR=./data/csv

FRONTEND_URL=http://localhost:5173
